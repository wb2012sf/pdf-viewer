{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Workbench",
  "version": "0.1.0",
  "identifier": "com.pdfworkbench.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Workbench",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": false, "scope": [] },
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "object-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "View, annotate and OCR PDFs, entirely offline.",
    "longDescription": "A cross-platform PDF workbench: view, search, annotate, fill forms, reorder pages and OCR scanned documents into searchable text. Everything runs on the machine it is opened on — no server, no network."
  }
}
