{
  "name": "pdf-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cross-platform PDF workbench: a macOS Preview equivalent that runs fully offline, with no server and no Docker.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.0",
    "@embedpdf/default-stamps": "^0.0.1",
    "@embedpdf/pdfium": "^2.15.0",
    "@embedpdf/plugin-export": "^2.15.0",
    "@embedpdf/plugin-stamp": "^2.15.0",
    "@embedpdf/react-pdf-viewer": "^2.15.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
